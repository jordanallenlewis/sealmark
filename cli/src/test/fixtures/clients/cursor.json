{
  "mcpServers": {
    "fs": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${workspaceFolder}"]
    },
    "tools": {
      "command": "node",
      "args": ["${userHome}/mcp/server.js"],
